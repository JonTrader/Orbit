# Database (Neon / Postgres)
DATABASE_URL=
# Dedicated Neon branch for `npm test`. The suite drops and recreates the
# public schema on every run, so this must never be DATABASE_URL.
DATABASE_URL_TEST=
# Optional: point `npm run db:migrate` at a branch other than DATABASE_URL.
DRIZZLE_DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# Optional comma-separated preview/custom origins trusted by Better Auth.
BETTER_AUTH_TRUSTED_ORIGINS=

# OAuth (Google)
# Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth (Microsoft)
# Redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Jobs (Inngest)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
